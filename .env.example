# ============ Storage (pick ONE) ============
# The app can store its data in Postgres or in Firestore. Set the variables
# for whichever you're using -- you do not need both.
#
#   DB_DRIVER=postgres   -> uses DATABASE_URL
#   DB_DRIVER=firestore  -> uses FIREBASE_SERVICE_ACCOUNT_JSON
#
# If DB_DRIVER is unset the app infers it: Firestore when a service account
# is configured and DATABASE_URL is not, otherwise Postgres. Setting both
# without DB_DRIVER keeps Postgres, so adding a Firebase key for Google
# sign-in can never silently move an existing deployment's data.
DB_DRIVER=

# --- Option A: Postgres (recommended) ---
# Connection string from Supabase, Neon, Vercel Postgres, or any Postgres host.
#
# SUPABASE: Project Settings -> Database -> Connection string. You are shown
# three variants; which one you want depends on how you run the app:
#
#   * Transaction pooler  (port 6543)  <- use this on Vercel / any serverless
#     Serverless spawns many short-lived instances; the pooler is what keeps
#     them from exhausting the connection limit.
#   * Session pooler      (port 5432, "pooler" in the host)
#     Use for a normal long-running `node server.js`.
#   * Direct connection   (db.<ref>.supabase.co:5432)
#     IPv6-only on newer projects, so it often fails from IPv4-only networks
#     and from Vercel. Prefer a pooler unless you know you need this.
#
# Replace [YOUR-PASSWORD] with your database password, and URL-encode any
# special characters in it (@ -> %40, # -> %23, / -> %2F) or the URL will
# parse wrongly and you'll get a confusing auth error.
#
# TLS is enabled automatically for any non-localhost host.
DATABASE_URL=postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Max Postgres connections held per app instance (default 5). Lower it if a
# hosted provider's connection cap is tight, raise it for a single big server.
PG_POOL_MAX=

# Comma-separated CORS allowlist. Leave EMPTY unless you serve the frontend
# from a different origin than the API -- the normal setup (Express serving
# the built SPA, or Vite proxying /api in dev) is same-origin and needs no
# CORS at all. Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Option B: Firestore ---
# Requires FIREBASE_SERVICE_ACCOUNT_JSON below (the *service account* key --
# the four public FIREBASE_* values are NOT enough to write to the database).
# Deploy firestore.rules alongside it; they deny all direct client access,
# which is correct because only this server ever touches Firestore.

# ============ Optional integrations ============
# Every one of these is feature-gated: if it's not set, that feature shows
# a clear "not configured yet" message in the UI instead of breaking.
# Add whichever ones you're ready to use -- none of them are required
# together, and you can add them one at a time.

# --- Sign in with Google ---
# Get this from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=

# --- Firebase ---
# From your Firebase project settings (console.firebase.google.com):
# these 4 are PUBLIC client config values (safe to expose to the browser --
# they identify the project, they do not grant any access). They power the
# optional Google sign-in popup fallback only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
#
# This one is a PRIVATE service account key (server-side only) and is a real
# secret -- never commit it, never expose it to the browser.
#   Firebase Console -> Project Settings -> Service Accounts
#     -> Generate new private key  (downloads a .json file)
# Paste the ENTIRE downloaded JSON as ONE line here.
#
# Required for BOTH:
#   * DB_DRIVER=firestore (storing the app's data in Firestore)
#   * verifying Firebase ID tokens for the Settings 2FA toggle
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# --- Testing email against a sandboxed provider ---
# A provider's trial mode, or a sending domain that is not verified yet, can
# refuse every address except the account owner's, so client email fails with a provider error
# that has nothing to do with this app. Set this and ALL outbound mail goes to
# that one inbox instead, with the intended recipient named in the subject --
# so the whole flow can be walked end to end before a domain is verified.
# The mail log still records who each message was actually for.
# Leave it unset in production.
MAIL_REDIRECT_TO=

# --- Super admin ---
# The account that can appoint administrators and read the audit log. If this
# is unset, the first boot promotes the longest-standing admin, so an existing
# workspace is never left without one.
SUPER_ADMIN_EMAIL=admin@example.com

# --- Stripe billing ---
# From https://dashboard.stripe.com/apikeys and /products
#
# Stripe is the ledger for every money figure the portal shows. With these set,
# the app mirrors invoices, charges, and subscriptions into its own `payments`
# and `billing` tables and renders only from that mirror, so a client's screen
# and the Stripe dashboard can never disagree.
#
# Point the webhook at  https://<your-app>/api/billing/webhook  and subscribe
# to at least:
#   invoice.paid, invoice.payment_failed, charge.succeeded, charge.refunded,
#   customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, checkout.session.completed
#
# Without the webhook nothing breaks -- an admin can press "Sync from Stripe"
# on the Payments page, which pulls the same history over the API.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google Drive (report storage) ---
# A service account (console.cloud.google.com -> IAM & Admin -> Service
# Accounts -> Create -> Keys -> Add key -> JSON), with the Drive API
# enabled on the project, and a Drive folder shared with that service
# account's email address (share it like you would with a person).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
GOOGLE_DRIVE_FOLDER_ID=

# --- ClickUp (admin "ClickUp" page) ---
# A personal API token: ClickUp -> Settings -> Apps -> API Token -> Generate.
# Read-only usage: the dashboard never writes back to ClickUp.
CLICKUP_API_TOKEN=pk_...
# Optional. Pin one workspace when the token can see several; otherwise the
# first workspace ClickUp returns is used.
CLICKUP_TEAM_ID=
# Optional. When set, every support ticket raised in this dashboard is also
# created as a task in this ClickUp list, and closing the ticket completes the
# task. Find the id in the list's ClickUp URL: /v/li/<CLICKUP_TICKETS_LIST_ID>
# Leave empty to keep tickets in this dashboard only.
CLICKUP_TICKETS_LIST_ID=
# Optional. The same arrangement for the Tasks board: when set, a task created
# here is also created in this ClickUp list, and edits and deletions follow it.
# Assignees are matched by email address, so somebody with no ClickUp seat
# mirrors as unassigned rather than failing the task. Find the id the same way:
# /v/li/<CLICKUP_TASKS_LIST_ID>. Leave empty to keep tasks in this dashboard
# only. ClickUp being unreachable never blocks a task from being created here.
CLICKUP_TASKS_LIST_ID=

# --- Slack (admin "Slack" page) ---
# A Bot User OAuth Token from https://api.slack.com/apps -> your app ->
# OAuth & Permissions. Required bot scopes:
#   channels:read, channels:history   (public channels)
#   channels:join                    (lets the bot add ITSELF to a client's
#                                     channel; without it somebody has to
#                                     /invite the bot to every one by hand)
#   groups:read,   groups:history     (private channels)
#   users:read                        (resolve author names)
# The bot only sees channels it has been invited to: /invite @yourbot
SLACK_BOT_TOKEN=xoxb-...
# Optional. Channel id that new-ticket alerts are posted to. Falls back to
# SLACK_NOTIFICATION_CHANNEL, then to the first channel the bot is a member of.
SLACK_TICKET_CHANNEL=
SLACK_NOTIFICATION_CHANNEL=

# --- New-ticket alerts ---
# Round-robin a new ticket to the PM/employee with the fewest open tickets.
# Set to "off" to leave every new ticket unassigned.
TICKET_AUTO_ASSIGN=on
# Absolute URL of this dashboard, used for the link in Slack and email alerts.
# Left empty, the app learns it from the browser's own Origin header on the
# first request -- which is http://localhost:5173 in development, where Vite
# serves the frontend and proxies /api. Set it explicitly in production, and
# for anything sent by a background job before a browser has ever called in.
APP_BASE_URL=https://dashboard.example.com

# ============ Email ============
# NOT optional in practice: sign-in codes are delivered by email. With no
# transport set, a client cannot sign in without an admin reading a code out
# of the Login Codes page (or handing over a one-tap sign-in link), and the
# server says so at boot. Configure this before putting a real client on the
# dashboard.
#
# Pick ONE transport. The app auto-detects in this order: SMTP2GO API, SMTP,
# webhook. MAIL_TRANSPORT=smtp2go|smtp|webhook forces one when several are set.
#
# With none set, messages are still rendered and listed on the admin Mail page
# as "Held" so you can review every template -- but nothing is delivered.
# Check the state any time on /portal/mail: it names the transport, has a
# "Verify connection" button, and a "Send test".

# --- Option 1: SMTP2GO over HTTPS (what this deployment uses) ---
# SMTP2GO dashboard -> Sending -> API Keys -> Add API Key, with the
# "/email/send" permission. Verify the sending domain first under
# Sending -> Verified Senders, and add the CNAME records it gives you at your
# DNS host, or every send comes back as an unverified-sender rejection.
#
# The HTTPS API is preferred over SMTP2GO's SMTP relay because outbound 587
# is unreliable from serverless hosts such as Vercel.
SMTP2GO_API_KEY=
# Only for SMTP2GO's regional endpoints (EU/AU). Leave empty for the default
# https://api.smtp2go.com/v3/email/send
SMTP2GO_API_URL=

# --- Option 2: SMTP (any mailbox you already own) ---
# SMTP2GO's own relay works here too, if you would rather use SMTP:
#   SMTP_HOST=mail.smtp2go.com  SMTP_PORT=587
#   SMTP_USER / SMTP_PASSWORD = an SMTP user from Sending -> SMTP Users
#   (that is a separate credential from the API key above)
# Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   SMTP_USER=you@yourdomain.com
#   SMTP_PASSWORD=<App password>   <- myaccount.google.com/apppasswords
#                                     (requires 2-Step Verification to be on;
#                                      your normal password will NOT work)
# Zoho Mail:      smtp.zoho.com          port 587
# Outlook 365:    smtp.office365.com     port 587
# Amazon SES:     email-smtp.<region>.amazonaws.com  port 587 (SMTP credentials,
#                                                     not your AWS access key)
# Hostinger/cPanel: usually smtp.yourdomain.com, port 465 with SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave empty to infer: true for port 465, false (STARTTLS) otherwise.
SMTP_SECURE=
# Only for a self-hosted server with a self-signed certificate. Never set this
# for Gmail, Outlook, SES, or any other public provider.
SMTP_ALLOW_SELF_SIGNED=

# --- Option 3: your own webhook ---
# Receives POST {from, to, subject, text, html}.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# Force a transport when more than one is configured.
MAIL_TRANSPORT=

# The From header. The domain must be a verified sender in SMTP2GO (or, on the
# SMTP transport, an address your mailbox is allowed to send as) or the
# provider will reject the message.
MAIL_FROM=EthixWeb Dashboard <noreply@ethixwebdashboard.com>
# Comma-separated inboxes that get every new ticket, on top of admin accounts.
# Every user with the admin role is already included -- this is for shared
# inboxes like support@ that are not accounts here.
ADMIN_ALERT_EMAILS=

# Branding for the emails. Defaults are the EthixWeb name and the red from the
# app theme; the logo falls back to a lettermark until APP_BASE_URL is set,
# because mail clients need an absolute image URL.
MAIL_BRAND_NAME=EthixWeb
MAIL_BRAND_COLOR=#c20000
# All email artwork -- the wordmark, the corner web, the fact icons and the
# progress bars -- is served from object storage rather than attached, so a
# notification carries ~15KB of text instead of ~154KB of PNGs.
#
# The trade: Outlook and Gmail hold remote images back until the reader asks
# for pictures, so the glyphs can be missing on first open. They are all
# decorative -- the fact each one labels is written beside it -- and the
# progress bar keeps its percentage in alt text.
#
# Both default to the EthixWeb bucket. Set them to move the assets elsewhere
# without shipping code; MAIL_ICON_BASE_URL is a folder, with no trailing
# slash, holding <name>.png for every icon.
MAIL_LOGO_URL=
MAIL_ICON_BASE_URL=
# Shown as "Contact support" in the footer when set.
MAIL_SUPPORT_EMAIL=

# --- Client-visible Slack thread ---
# Every ticket opens one Slack thread, and the client portal can show it.
#   summary (default) -> only the updates this dashboard posted
#   full              -> the whole thread, including your team's own replies
# Leave it on summary unless your team knows the client is reading along.
CLIENT_SLACK_THREAD=summary

# Optional. Set automatically by Vercel; only needed locally if you want
# to test production-mode cookie settings.
NODE_ENV=development

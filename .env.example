# ============ Storage (pick ONE) ============
# The app can store its data in Postgres or in Firestore. Set the variables
# for whichever you're using -- you do not need both.
#
#   DB_DRIVER=postgres   -> uses DATABASE_URL
#   DB_DRIVER=firestore  -> uses FIREBASE_SERVICE_ACCOUNT_JSON
#
# If DB_DRIVER is unset the app infers it: Firestore when a service account
# is configured and DATABASE_URL is not, otherwise Postgres. Setting both
# without DB_DRIVER keeps Postgres, so adding a Firebase key for Google
# sign-in can never silently move an existing deployment's data.
DB_DRIVER=

# --- Option A: Postgres (recommended) ---
# Connection string from Supabase, Neon, Vercel Postgres, or any Postgres host.
#
# SUPABASE: Project Settings -> Database -> Connection string. You are shown
# three variants; which one you want depends on how you run the app:
#
#   * Transaction pooler  (port 6543)  <- use this on Vercel / any serverless
#     Serverless spawns many short-lived instances; the pooler is what keeps
#     them from exhausting the connection limit.
#   * Session pooler      (port 5432, "pooler" in the host)
#     Use for a normal long-running `node server.js`.
#   * Direct connection   (db.<ref>.supabase.co:5432)
#     IPv6-only on newer projects, so it often fails from IPv4-only networks
#     and from Vercel. Prefer a pooler unless you know you need this.
#
# Replace [YOUR-PASSWORD] with your database password, and URL-encode any
# special characters in it (@ -> %40, # -> %23, / -> %2F) or the URL will
# parse wrongly and you'll get a confusing auth error.
#
# TLS is enabled automatically for any non-localhost host.
DATABASE_URL=postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Max Postgres connections held per app instance (default 5). Lower it if a
# hosted provider's connection cap is tight, raise it for a single big server.
PG_POOL_MAX=

# Comma-separated CORS allowlist. Leave EMPTY unless you serve the frontend
# from a different origin than the API -- the normal setup (Express serving
# the built SPA, or Vite proxying /api in dev) is same-origin and needs no
# CORS at all. Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Option B: Firestore ---
# Requires FIREBASE_SERVICE_ACCOUNT_JSON below (the *service account* key --
# the four public FIREBASE_* values are NOT enough to write to the database).
# Deploy firestore.rules alongside it; they deny all direct client access,
# which is correct because only this server ever touches Firestore.

# ============ Optional integrations ============
# Every one of these is feature-gated: if it's not set, that feature shows
# a clear "not configured yet" message in the UI instead of breaking.
# Add whichever ones you're ready to use -- none of them are required
# together, and you can add them one at a time.

# --- Sign in with Google ---
# Get this from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=

# --- Firebase ---
# From your Firebase project settings (console.firebase.google.com):
# these 4 are PUBLIC client config values (safe to expose to the browser --
# they identify the project, they do not grant any access). They power the
# optional Google sign-in popup fallback only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
#
# This one is a PRIVATE service account key (server-side only) and is a real
# secret -- never commit it, never expose it to the browser.
#   Firebase Console -> Project Settings -> Service Accounts
#     -> Generate new private key  (downloads a .json file)
# Paste the ENTIRE downloaded JSON as ONE line here.
#
# Required for BOTH:
#   * DB_DRIVER=firestore (storing the app's data in Firestore)
#   * verifying Firebase ID tokens for the Settings 2FA toggle
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# --- Stripe billing ---
# From https://dashboard.stripe.com/apikeys and /products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google Drive (report storage) ---
# A service account (console.cloud.google.com -> IAM & Admin -> Service
# Accounts -> Create -> Keys -> Add key -> JSON), with the Drive API
# enabled on the project, and a Drive folder shared with that service
# account's email address (share it like you would with a person).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
GOOGLE_DRIVE_FOLDER_ID=

# Optional. Set automatically by Vercel; only needed locally if you want
# to test production-mode cookie settings.
NODE_ENV=development

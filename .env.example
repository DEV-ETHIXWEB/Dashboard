# ============ Required ============
# Postgres connection string (from Vercel Storage, Neon, Supabase, or any
# Postgres host). The app will not start without this.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ============ Optional integrations ============
# Every one of these is feature-gated: if it's not set, that feature shows
# a clear "not configured yet" message in the UI instead of breaking.
# Add whichever ones you're ready to use -- none of them are required
# together, and you can add them one at a time.

# --- Sign in with Google ---
# Get this from https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application)
GOOGLE_CLIENT_ID=

# --- Firebase (Two-Factor Authentication: phone SMS code + email link) ---
# From your Firebase project settings (console.firebase.google.com):
# these 4 are PUBLIC client config values (safe to expose to the browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# This one is a PRIVATE service account key (server-side only) --
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the ENTIRE downloaded JSON file as one line here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# --- Stripe billing ---
# From https://dashboard.stripe.com/apikeys and /products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google Drive (report storage) ---
# A service account (console.cloud.google.com -> IAM & Admin -> Service
# Accounts -> Create -> Keys -> Add key -> JSON), with the Drive API
# enabled on the project, and a Drive folder shared with that service
# account's email address (share it like you would with a person).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
GOOGLE_DRIVE_FOLDER_ID=

# Optional. Set automatically by Vercel; only needed locally if you want
# to test production-mode cookie settings.
NODE_ENV=development

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:frontend-only", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "dashboard-pgmem",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:pgmem", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "frontend-throwaway-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5199", "--strictPort"],
      "cwd": "frontend",
      "env": { "VITE_API_TARGET": "http://127.0.0.1:4100" },
      "port": 5199
    }
  ]
}
